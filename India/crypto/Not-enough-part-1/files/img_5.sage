from sage.all import *

N = Integer()
e = Integer(65537)
p_hi = Integer(2615850379731327725778203313365784512838922702185011257029931947846122736769634242897120915009678837272252972592332233245419497072070)
LEAK_BITS = 72

R.<x> = PolynomialRing(Zmod(N))
base = p_hi << LEAK_BITS

f = x + base

print("[*] running small_roots")
roots = f.small_roots(X=2^LEAK_BITS, beta=0.5)

print("[*] roots =", roots)

if not roots:
    raise ValueError("no root found")

x0 = Integer(roots[0])
p = base + x0

if N % p != 0:
    raise ValueError("wrong root")

q = N // p
phi = (p - 1) * (q - 1)
d = inverse_mod(e, phi)

print("p =", p)
print("q =", q)
print("d =", d)
