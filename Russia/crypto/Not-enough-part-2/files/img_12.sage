from sage.all import *

def recover_p(N, p_hi, leak_bits):
    base = p_hi << leak_bits
    X = 2^leak_bits
    R.<x> = PolynomialRing(Zmod(N))
    f = x + base
    roots = f.small_roots(X=X, beta=0.5, epsilon=0.02)
    if not roots:
        # Пробуем другой beta
        roots = f.small_roots(X=X, beta=0.4, epsilon=0.02)
    if not roots:
        raise ValueError("No root found")
    x0 = Integer(roots[0])
    p = base + x0
    assert N % p == 0, "p does not divide N"
    return p

N1 = 
p1_hi = 2473957629125585196443465742830204773124470235023864499097528953490681406006927518435938920617611579924972782017848204307269253415431
p1 = recover_p(N1, p1_hi, 72)
print("p1 =", p1)

N2 = 
p2_hi = 8323136952560429531827321572791762454121167757363054897308938675603963868132925956974213137032081376425627149514834712272012976728
p2 = recover_p(N2, p2_hi, 80)
print("p2 =", p2)
